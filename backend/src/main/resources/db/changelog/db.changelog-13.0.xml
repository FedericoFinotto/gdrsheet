<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
       http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Gestione schede per mondo: i tipi item (enum TipoItem) e le liste/domini incantesimi
        (oggi liberi, catalogo hardcoded in frontend/spellLists.ts) diventano abilitabili
        singolarmente per mondo, in opt-in (nessuna riga = non abilitato). I mondi già esistenti
        al momento di questa migration vengono popolati con TUTTO ciò che oggi possono già usare
        senza restrizioni, per non cambiare comportamento; i mondi creati dopo partono vuoti e
        devono abilitare esplicitamente quello che usano.
    -->

    <changeSet id="1300" author="developer">
        <comment>Catalogo globale dei codici lista/dominio incantesimi (SP_*), condiviso tra tutti i mondi.</comment>
        <createTable tableName="lista_incantesimi">
            <column name="codice" type="varchar(50)">
                <constraints primaryKey="true"/>
            </column>
            <column name="etichetta" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1301" author="developer">
        <comment>Abilitazione opt-in di un TipoItem per un mondo.</comment>
        <createTable tableName="mondo_tipo_item_abilitato">
            <column name="id" type="serial">
                <constraints primaryKey="true"/>
            </column>
            <column name="id_mondo" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="mondo_tipo_item_abilitato"
                              columnNames="id_mondo, tipo"
                              constraintName="uq_mondo_tipo_item_abilitato"/>
        <addForeignKeyConstraint
                baseTableName="mondo_tipo_item_abilitato"
                baseColumnNames="id_mondo"
                referencedTableName="mondo"
                referencedColumnNames="id"
                constraintName="fk_mondo_tipo_item_abilitato_mondo"/>
    </changeSet>

    <changeSet id="1302" author="developer">
        <comment>Abilitazione opt-in di un codice lista_incantesimi per un mondo.</comment>
        <createTable tableName="mondo_lista_incantesimi_abilitata">
            <column name="id" type="serial">
                <constraints primaryKey="true"/>
            </column>
            <column name="id_mondo" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="codice_lista" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="mondo_lista_incantesimi_abilitata"
                              columnNames="id_mondo, codice_lista"
                              constraintName="uq_mondo_lista_incantesimi_abilitata"/>
        <addForeignKeyConstraint
                baseTableName="mondo_lista_incantesimi_abilitata"
                baseColumnNames="id_mondo"
                referencedTableName="mondo"
                referencedColumnNames="id"
                constraintName="fk_mondo_lista_incantesimi_abilitata_mondo"/>
        <addForeignKeyConstraint
                baseTableName="mondo_lista_incantesimi_abilitata"
                baseColumnNames="codice_lista"
                referencedTableName="lista_incantesimi"
                referencedColumnNames="codice"
                constraintName="fk_mondo_lista_incantesimi_abilitata_lista"/>
    </changeSet>

