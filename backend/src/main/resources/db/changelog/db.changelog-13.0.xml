    <changeSet id="1304" author="developer">
        <comment>
            Abilita per i mondi già esistenti tutti i TipoItem e tutte le liste_incantesimi: i
            mondi presenti prima di questa migration continuano a poter usare tutto come prima
            (nessuna restrizione nuova). I mondi creati dopo questa migration NON vengono toccati
            da questo changeSet (gira solo una volta, al momento dell'upgrade) e partono senza
            nulla abilitato: dovranno abilitare esplicitamente ciò che usano.
        </comment>
        <sql>
            INSERT INTO mondo_tipo_item_abilitato (id_mondo, tipo)
            SELECT m.id, t.tipo
            FROM mondo m
            CROSS JOIN (VALUES
                ('ABILITA'),('TALENTO'),('OGGETTO'),('CONSUMABILE'),('ARMA'),('MUNIZIONE'),
                ('EQUIPAGGIAMENTO'),('PERSONAGGIO'),('CLASSE'),('RAZZA'),('ATTACCO'),('ALTRO'),
                ('LIVELLO'),('MALEDIZIONE'),('INCANTESIMO'),('TRASFORMAZIONE'),('AVANZAMENTO'),
                ('COMP'),('LINGUA'),('IDOLO'),('FRUTTO'),('FORMA'),('PRIVILEGIO'),('CONTENITORE'),
                ('PATTO'),('NOTIZIA'),('EFFETTO'),('QUEST'),('VEICOLO'),('INFO'),('CATEGORIA'),
                ('TAG'),('RANDOMIZZATORE'),('CASO'),('SKILL_TRICK'),('IMMAGINE')
            ) AS t(tipo);
        </sql>
        <sql>
            INSERT INTO mondo_lista_incantesimi_abilitata (id_mondo, codice_lista)
            SELECT m.id, l.codice
            FROM mondo m
            CROSS JOIN lista_incantesimi l;
        </sql>
        <rollback>
            <sql>DELETE FROM mondo_tipo_item_abilitato;</sql>
            <sql>DELETE FROM mondo_lista_incantesimi_abilitata;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
